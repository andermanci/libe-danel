---

const { active } = Astro.props;

---

<section class="w-11/12 md:w-5/6 lg:w-4/6 flex flex-col items-center pt-8 pb-16 md:py-12 gap-8">
    <a href="/" class="flex items-center gap-2 hover:scale-105 transition">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" class="h-[12px]"><path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/></svg>
        Volver al inicio
    </a>
    <h5 class="text-xl text-center">NUESTROS RECUERDOS</h5>
    <h1 class="text-primary text-5xl text-center">Fotógrafo</h1>

    <div class="flex flex-wrap justify-center gap-4">
        <a href="/galeria/fotografo/casa-danel" class={`${active === 'casa-danel' ? 'text-primary' : 'text-gray-500'} font-light`}>Casa Danel</a>
        <a href="/galeria/fotografo/casa-libe" class={`${active === 'casa-libe' ? 'text-primary' : 'text-gray-500'} font-light`}>Casa Libe</a>
        <a href="/galeria/fotografo/novios" class={`${active === 'novios' ? 'text-primary' : 'text-gray-500'} font-light`}>Novios</a>
        <a href="/galeria/fotografo/ceremonia" class={`${active === 'ceremonia' ? 'text-primary' : 'text-gray-500'} font-light`}>Ceremonia</a>
        <a href="/galeria/fotografo/cocktail" class={`${active === 'cocktail' ? 'text-primary' : 'text-gray-500'} font-light`}>Cocktail</a>
        <a href="/galeria/fotografo/invitados" class={`${active === 'invitados' ? 'text-primary' : 'text-gray-500'} font-light`}>Invitados</a>
        <a href="/galeria/fotografo/comida" class={`${active === 'comida' ? 'text-primary' : 'text-gray-500'} font-light`}>Comida</a>
        <a href="/galeria/fotografo/baile" class={`${active === 'baile' ? 'text-primary' : 'text-gray-500'} font-light`}>Baile</a>
    </div>
</section>